---
import { Image } from "astro:assets";
import { FELLOWS } from "../data/site";
---

<div class="fellows">
  <h3 class="side-title">Fellows 友情链接</h3>
  {
    FELLOWS.map((f) => (
      <a class="fellow" href={f.url} target="_blank" rel="noopener">
        <Image class="fellow-icon" src={f.icon} alt="" width={40} height={40} />
        {f.name}
      </a>
    ))
  }
  <a class="fellow fellow-rss" href="/rss.xml" target="_blank" rel="noopener" title="用 RSS 阅读器订阅本站">
    <svg class="fellow-icon" viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="5.5" cy="14.5" r="1.6" fill="currentColor" />
      <path d="M4 9.2a6.8 6.8 0 0 1 6.8 6.8M4 4.6A11.4 11.4 0 0 1 15.4 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    RSS 订阅
  </a>
</div>
